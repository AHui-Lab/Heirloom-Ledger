  "story_nodes": [
    {
      "id": "ledger",
      "day": 1,
      "actor": "zhou",
      "requires": [],
      "title": "没有价格的一行",
      "text": "旧账写着：山水一幅、茶器数件，周代接，暂存。落款处没有收购价。",
      "choices": [
        {
          "id": "record",
          "label": "记下疑点，先保留原页",
          "flag": "ledger"
        },
        {
          "id": "defer",
          "defer": true,
          "label": "今天先处理营业，稍后再查"
        }
      ]
    },
    {
      "id": "photo",
      "day": 3,
      "actor": "sun",
      "requires": [
        "ledger"
      ],
      "title": "旧照里的一角",
      "text": "孙玉梅带来一张茶庄旧照。柜边确有相似锡罐，但一张照片不能证明这批东西全归她家。",
      "choices": [
        {
          "id": "compare",
          "label": "留下照片副本，与器物分别比对",
          "flag": "photo",
          "relation": 1
        },
        {
          "id": "dismiss",
          "label": "不留照片，也不继续核对这条来源",
          "relation": -1
        }
      ]
    },
    {
      "id": "custody",
      "day": 4,
      "actor": "zhou",
      "requires": [
        "ledger"
      ],
      "title": "签名人的身份",
      "text": "周伯安承认账上的“周”是自己。当年茶庄停业，他替人把几件物件送给爷爷暂管。签名只证明经手，不代表他是原主。",
      "choices": [
        {
          "id": "ask_stub",
          "label": "请他找找当年的交接存根",
          "flag": "custody",
          "relation": 1
        },
        {
          "id": "rush",
          "label": "先按库存处理，手续日后再谈",
          "relation": -1
        }
      ]
    },
    {
      "id": "offer",
      "day": 5,
      "actor": "he",
      "requires": [
        "ledger"
      ],
      "title": "先成交，后补纸",
      "text": "何景明愿意为这批旧物寻找买家。他拿来的转售清单列有器名与几张示意，但没有逐件编号和件数核对，也缺委托授权。",
      "choices": [
        {
          "id": "audit",
          "label": "要求逐件核对并补齐授权",
          "flag": "audit",
          "relation": -1
        },
        {
          "id": "promise",
          "label": "答应优先让他看货，但不承诺出售",
          "flag": "promised_he",
          "relation": 1
        }
      ]
    },
    {
      "id": "repair",
      "day": 6,
      "actor": "xu",
      "requires": [
        "photo",
        "offer_seen"
      ],
      "title": "同名不等于同一件",
      "text": "许闻溪提醒：旧照中的罐盖轮廓与何景明清单上的示意不一致。后配的盖子不等于整件赝品，但不能把它写成完整原配。",
      "choices": [
        {
          "id": "note",
          "label": "把这条差异记在器物说明里",
          "flag": "repair",
          "relation": 1
        },
        {
          "id": "wait",
          "defer": true,
          "label": "先不下结论，保留待查"
        }
      ]
    },
    {
      "id": "stub",
      "day": 7,
      "actor": "zhou",
      "requires": [
        "custody"
      ],
      "title": "交接存根",
      "text": "周伯安找到了存根：代接寄存，未议买断。另页载有孙家联系人，仍需本人确认是否愿意售出。",
      "choices": [
        {
          "id": "copy",
